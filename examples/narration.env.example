# Production TTS adapter. The command receives a JSON request at ${input}
# and must write the final audio bytes to ${output}.
FORGE_TTS_COMMAND=/opt/tts/bin/synthesize
FORGE_TTS_ARGS=--input ${input} --output ${output}
FORGE_TTS_MODEL=production-model
FORGE_TTS_VOICE=default
FORGE_TTS_TIMEOUT_MS=600000
FORGE_TTS_MAX_TEXT_CHARS=500000

# Local/test only: no provider credentials required.
# FORGE_TTS_MODE=deterministic

# Optional override when ffprobe is not on PATH.
# FORGE_FFPROBE_COMMAND=/usr/bin/ffprobe
