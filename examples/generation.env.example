# Production generation bounds
FORGE_GENERATION_TIMEOUT_MS=600000
FORGE_GENERATION_MAX_ATTEMPTS=3
FORGE_GENERATION_MAX_OUTPUT_BYTES=536870912
FORGE_GENERATION_MAX_TEXT_CHARS=2000000
FORGE_GENERATION_MAX_WIDTH=16384
FORGE_GENERATION_MAX_HEIGHT=16384
FORGE_GENERATION_MAX_DURATION_SECONDS=3600
FORGE_GENERATION_RETRY_BASE_MS=1000

# Deterministic local/test mode only. Never enable in production.
# FORGE_GENERATION_MODE=deterministic

# Production command adapters. Keep credentials in the process environment used by the command.
# FORGE_IMAGE_GENERATION_COMMAND=/opt/providers/image-generate
# FORGE_IMAGE_GENERATION_ARGS=--input ${input} --output ${output}
# FORGE_IMAGE_GENERATION_PROVIDER=provider-name
# FORGE_IMAGE_GENERATION_MODEL=model-name
# FORGE_VIDEO_GENERATION_COMMAND=/opt/providers/video-generate
# FORGE_VIDEO_GENERATION_ARGS=--input ${input} --output ${output}
# FORGE_VIDEO_GENERATION_PROVIDER=provider-name
# FORGE_VIDEO_GENERATION_MODEL=model-name
# FORGE_TEXT_GENERATION_COMMAND=/opt/providers/text-generate
# FORGE_TEXT_GENERATION_ARGS=--input ${input} --output ${output}
# FORGE_TEXT_GENERATION_PROVIDER=provider-name
# FORGE_TEXT_GENERATION_MODEL=model-name

# Worker registration
FORGE_WORKER_HANDLERS=src/generation/worker-handlers.js
