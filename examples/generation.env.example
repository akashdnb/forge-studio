# Generation worker
# Use deterministic mode for local development and CI. Production must use configured provider endpoints.
FORGE_GENERATION_MODE=deterministic
FORGE_GENERATION_TIMEOUT_MS=600000
FORGE_GENERATION_MAX_ATTEMPTS=3
FORGE_GENERATION_MAX_REQUESTS=50
FORGE_GENERATION_MAX_OUTPUT_BYTES=1073741824
FORGE_GENERATION_MAX_TEXT_CHARS=1000000
FORGE_GENERATION_MAX_IMAGE_WIDTH=16384
FORGE_GENERATION_MAX_IMAGE_HEIGHT=16384
FORGE_GENERATION_MAX_VIDEO_DURATION_SECONDS=3600
FORGE_GENERATION_MAX_VIDEO_WIDTH=16384
FORGE_GENERATION_MAX_VIDEO_HEIGHT=16384

# Text provider (OpenAI-compatible by default)
# FORGE_GENERATION_TEXT_PROVIDER=openai-compatible
# FORGE_GENERATION_TEXT_ENDPOINT=https://provider.example/v1/chat/completions
# FORGE_GENERATION_TEXT_TOKEN=<secret>
# FORGE_GENERATION_TEXT_MODEL=<model>

# Image provider: forge-generation-v1 JSON contract
# FORGE_GENERATION_IMAGE_PROVIDER=http-json
# FORGE_GENERATION_IMAGE_ENDPOINT=https://provider.example/generate/image
# FORGE_GENERATION_IMAGE_TOKEN=<secret>
# FORGE_GENERATION_IMAGE_MODEL=<model>

# Video provider: forge-generation-v1 JSON contract
# FORGE_GENERATION_VIDEO_PROVIDER=http-json
# FORGE_GENERATION_VIDEO_ENDPOINT=https://provider.example/generate/video
# FORGE_GENERATION_VIDEO_TOKEN=<secret>
# FORGE_GENERATION_VIDEO_MODEL=<model>

# Never put provider tokens in job payloads, prompts, artifact metadata, logs or committed files.
