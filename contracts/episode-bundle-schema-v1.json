{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge://contracts/episode-bundle/v1",
  "title": "Forge Episode Bundle",
  "type": "object",
  "required": ["format", "schemaVersion", "bundleId", "createdAt", "source", "compatibility", "exclusions", "replay"],
  "properties": {
    "format": { "const": "forge-episode-bundle" },
    "schemaVersion": { "const": 1 },
    "bundleId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "createdAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["projectId", "tenantFingerprint"],
      "properties": {
        "projectId": { "type": "string" },
        "episodeId": { "type": ["string", "null"] },
        "tenantFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": ["minSchemaVersion", "maxSchemaVersion"],
      "properties": {
        "minSchemaVersion": { "type": "integer", "const": 1 },
        "maxSchemaVersion": { "type": "integer", "const": 1 },
        "nodeMajor": { "type": "integer", "minimum": 20 }
      },
      "additionalProperties": false
    },
    "exclusions": { "type": "array", "items": { "type": "string" } },
    "replay": {
      "type": "object",
      "required": ["sideEffectsSuppressed", "historicalInputsOnly", "deterministicFixtureVersion"],
      "properties": {
        "sideEffectsSuppressed": { "const": true },
        "historicalInputsOnly": { "const": true },
        "deterministicFixtureVersion": { "type": "integer", "const": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
