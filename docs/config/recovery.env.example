# Recovery storage
FORGE_BACKUP_DIR=.forge-backups
FORGE_BACKUP_RETENTION_DAYS=14
FORGE_BACKUP_MAX_ARTIFACTS=5000
FORGE_BACKUP_MAX_ARTIFACT_BYTES=536870912
FORGE_BACKUP_TIMEOUT_MS=1800000
FORGE_RECOVERY_MAX_CONCURRENCY=1
FORGE_RECOVERY_ARTIFACT_CONCURRENCY=4

# Generate with: openssl rand -base64 32
# Never commit a real value.
FORGE_BACKUP_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
FORGE_BACKUP_ENCRYPTION_KEY_ID=primary

# Recovery operator authentication uses the normal signed Forge identity.
FORGE_AUTH_SIGNING_SECRET=<32+-character-secret>

# Restore verification must target a disposable database URL with this explicit prefix.
# Example: postgres://forge:forge@localhost:5432/forge_restore_
FORGE_RECOVERY_TARGET_PREFIX=postgres://forge:forge@localhost:5432/forge_restore_

# Local isolated artifact store for verification. Production S3 deployments should use
# FORGE_RECOVERY_TARGET_S3_BUCKET and optional endpoint/region instead.
FORGE_RECOVERY_TARGET_STORAGE_DIR=.forge-recovery-storage
FORGE_RECOVERY_TARGET_S3_BUCKET=
FORGE_RECOVERY_TARGET_S3_ENDPOINT=
FORGE_RECOVERY_TARGET_S3_REGION=us-east-1

# This only declares that an external PostgreSQL WAL archive/PITR system is configured.
# Forge records the backup WAL LSN; it does not archive WAL itself.
FORGE_BACKUP_PITR_ENABLED=false

# Emergency-only override; never enable on production deployments.
FORGE_RESTORE_ALLOW_NONISOLATED=false
