# Recovery storage
FORGE_BACKUP_DIR=.forge-backups
FORGE_BACKUP_RETENTION_DAYS=14
FORGE_BACKUP_MAX_ARTIFACTS=5000
FORGE_BACKUP_MAX_ARTIFACT_BYTES=536870912
FORGE_BACKUP_TIMEOUT_MS=1800000

# Generate with: openssl rand -base64 32
# Never commit a real value.
FORGE_BACKUP_ENCRYPTION_KEY=<base64-encoded-32-byte-key>

# This only declares that an external PostgreSQL WAL archive/PITR system is configured.
# Forge records the backup WAL LSN; it does not archive WAL itself.
FORGE_BACKUP_PITR_ENABLED=false
