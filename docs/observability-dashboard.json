{"title":"Forge Studio Production","schemaVersion":39,"panels":[{"type":"timeseries","title":"API request rate","targets":[{"expr":"sum(rate(forge_http_requests_total[5m]))"}]},{"type":"timeseries","title":"API 5xx rate","targets":[{"expr":"sum(rate(forge_http_requests_total{status=~\"5..\"}[5m]))"}]},{"type":"timeseries","title":"Queue depth","targets":[{"expr":"sum(forge_job_queue_depth{outcome=\"queued\"})"}]},{"type":"timeseries","title":"Job throughput","targets":[{"expr":"sum by(outcome)(rate(forge_jobs_total[5m]))"}]},{"type":"timeseries","title":"Provider failures","targets":[{"expr":"sum by(provider,outcome)(rate(forge_provider_requests_total[10m]))"}]},{"type":"timeseries","title":"Artifact IO","targets":[{"expr":"sum by(outcome)(rate(forge_artifact_io_total[10m]))"}]},{"type":"timeseries","title":"Dependency health","targets":[{"expr":"forge_dependency_health"}]}]}