{
  "name":"forge-studio-core","private":true,"version":"0.6.1","description":"Forge Studio production control plane, workflow orchestration, publishing and Shorts handoff","type":"commonjs",
  "scripts":{
    "start":"node -r ./src/governance/bootstrap.js -r ./src/providers/credential-bootstrap.js -r ./src/capacity/http-auto.js -r ./src/capacity/reservation-http-auto.js src/versioned-server.js",
    "worker":"node -r ./src/governance/bootstrap.js -r ./src/providers/credential-bootstrap.js -r ./src/capacity/all-hooks.js src/runtime/worker-entry.js",
    "event-worker":"node src/events/delivery-worker.js","event-api":"node -r ./src/governance/bootstrap.js src/events/server.js","inbound-webhook-api":"node -r ./src/governance/bootstrap.js src/events/inbound-server.js","test":"node --test",
    "runtime:check":"node -e \"const {validateRuntimeConfig}=require('./src/runtime/runtime-policy'); const r=validateRuntimeConfig(process.env,{requirePersistence:true}); if(!r.ok){console.error(JSON.stringify(r.issues,null,2)); process.exit(1)} console.log(JSON.stringify(r.config,null,2))\"",
    "check":"node --check src/capacity/capacity-model.js && node --check src/capacity/capacity-control.js && node --check src/capacity/http-auto.js && node --check src/capacity/reservation-http-auto.js && node --check src/capacity/reservations.js && node --check src/capacity/job-hooks.js && node --check src/capacity/provider-storage-hooks.js && node --check src/capacity/runner-hook.js && node --check src/capacity/all-hooks.js && node --check src/runtime/worker-entry.js && node --check src/scheduling/workflow-scheduler.js && node --check src/governance/bootstrap.js && node --check src/providers/credential-bootstrap.js && node --test",
    "migrate":"node src/migrate.js","demo":"node scripts/demo-workflow.js","contracts":"node scripts/check-api-contracts.js","backup":"node scripts/forge-recovery.js backup","backup:verify":"node scripts/forge-recovery.js verify","backup:restore":"node scripts/forge-recovery.js restore","backup:retention":"node scripts/recovery-retention.js","privacy:enqueue":"node scripts/privacy-retention.js","integrity:scan":"node scripts/reconcile-integrity.js scan","integrity:plan":"node scripts/reconcile-integrity.js plan","integrity:apply":"node scripts/reconcile-integrity.js apply","recovery:health":"node scripts/forge-recovery-http.js","recovery:operator":"node scripts/forge-recovery-operator-http.js","release:preflight":"node scripts/release-preflight.js","release:control":"node scripts/release-control.js","acceptance":"node scripts/acceptance-entrypoint.js"
  },
  "engines":{"node":">=20"},"dependencies":{"@aws-sdk/client-s3":"^3.913.0"},"optionalDependencies":{"ffmpeg-static":"^5.2.0","pg":"^8.13.1"}
}
