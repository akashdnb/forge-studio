# Copy to .env on the Oracle VM. Never commit the real file.
NODE_ENV=production

POSTGRES_DB=forge
POSTGRES_USER=forge
POSTGRES_PASSWORD=replace-with-a-long-random-password

API_BEARER_TOKEN=replace-with-a-long-random-token
FORGE_AUTH_SIGNING_SECRET=replace-with-at-least-32-random-bytes
FORGE_SECRET_ENCRYPTION_KEY=replace-with-32-byte-hex-key
FORGE_EVENT_SECRET_KEY=replace-with-a-long-random-event-secret
FORGE_RUNNER_CALLBACK_TOKEN=replace-with-a-long-random-callback-token
FORGE_STATIC_ACTOR_ID=oracle-owner
FORGE_STATIC_TENANT_ID=oracle-tenant

# The dashboard is served by the same Caddy origin, so leave this empty unless
# you later put the API behind a separate origin.
CORS_ORIGIN=

FORGE_RUNTIME_POLICY_ENABLED=true
FORGE_REQUIRE_SECRET_ENCRYPTION=true
RUN_MIGRATIONS_ON_START=false

# Bootstrap deployment uses the VM's persistent volume. Move artifacts to OCI
# Object Storage before treating this VM as a durable production artifact store.
FORGE_STORAGE_DRIVER=local
FORGE_STORAGE_LOCAL_ROOT=/var/lib/forge/storage
FORGE_STORAGE_MAX_BYTES=10737418240

# Heavy execution can be moved to GitHub Actions after a GitHub token is added.
FORGE_GITHUB_ACTIONS_ENABLED=false
FORGE_GITHUB_ACTIONS_MODE=github
FORGE_GITHUB_REPOSITORY=akashdnb/forge-studio
FORGE_GITHUB_REF=main
