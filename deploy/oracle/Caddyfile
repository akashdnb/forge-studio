:80 {
  root * /srv/public
  encode gzip

  handle /webhooks/* {
    reverse_proxy forge-inbound-webhook:8091
  }

  handle /v1/event-* {
    reverse_proxy forge-event-api:8090
  }

  handle /v1/* {
    reverse_proxy forge-api:8080
  }

  handle /healthz {
    reverse_proxy forge-api:8080
  }

  handle /readyz {
    reverse_proxy forge-api:8080
  }

  handle /openapi.json {
    reverse_proxy forge-api:8080
  }

  file_server
}
